DATABASE_URL=postgresql://spaceos:spaceos@localhost:5432/spaceos
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=["http://localhost:5173"]
# [계정층] 실행 환경. 비우면 자동 판정한다 — Vercel 은 VERCEL=1 을 심으므로 prod 로 잡힌다.
# dev 가 아니면 아래 JWT_SECRET 이 기본값일 때 **앱이 아예 안 뜬다**(fail closed).
APP_ENV=
# [계정층] JWT 서명 키 — 반드시 배포 환경마다 고유한 무작위 값으로 채울 것.
# 기본값(config.py 의 "dev-only-change-me") 그대로 배포하면 누구나 토큰을 위조할 수 있다.
# 생성 예: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
# [운영] 관리자 API(X-Admin-Token) — /admin/coverage · /admin/usage(KPI② 파일럿 사용량).
# 미설정이면 관리자 라우터 전체가 403 이다(fail closed).
ADMIN_TOKEN=
# [Program] LLM 콘텐츠 생성 — Anthropic Claude (console.anthropic.com → API Keys)
# 선불 크레딧제라 잔액 0 이면 호출이 실패한다. Billing 에서 auto-reload + 사용량 알림을 켤 것.
LLM_API_KEY=
# 모델 override (비우면 config.py 기본값 claude-sonnet-5).
# claude-sonnet-5 = 기본·대량 생성 / claude-opus-5 = 품질 우선 시연 / claude-haiku-4-5 = 최저비용.
# Program 은 검증 브리프(텍스트)만 보낸다 — 사진 입력은 2026-09-17 대상 재정의로 빠졌다.
LLM_MODEL=

# ===== 네이버 클라우드 플랫폼 Maps (REST: Geocoding/Directions) =====
# Client ID(=Key ID)와 Client Secret 둘 다 필요. 실제 값은 apps/backend/.env 에 넣고 커밋 금지.
NAVER_MAPS_KEY_ID=9nbzrvj8qj
NAVER_MAPS_CLIENT_SECRET=__PUT_YOUR_CLIENT_SECRET_HERE__
