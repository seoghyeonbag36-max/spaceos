# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.env
.mlruns/
mlruns/

# 로컬 `vercel build` 스캐폴드 — 커밋도 배포도 하지 않는다(.vercelignore 도 같이 막는다).
# requires-python 이 로컬 파이썬을 따라 적혀 원격 빌드(3.12+)를 깨뜨린다(2026-08-16).
/pyproject.toml
/uv.lock
.vercel/
# CLI 가 설치해 두는 패키지 사본(1,612파일 19MB) — sys.path 에 없어 런타임과 무관하다
.vercel_python_packages/

# Node
node_modules/
dist/
.vite/
*.local

# Data lake (로컬 레이어 — 원본/대용량 제외)
data/bronze/*
data/silver/*
data/gold/*
!data/bronze/.gitkeep
!data/silver/.gitkeep
# 집계구 PIP 배정표 3종. 원천 shapefile 은 bronze(전체 gitignore)라 git 으로 복구되지
# 않는다 — 이 표들이 조인 결과의 유일한 durable 기록이므로 추적한다.
#   unit  공실 유닛 528호   → 집계구 293곳   (Posting `foot` 서열)
#   node  점포 노드 40,388  → 집계구 1,155곳 (Platform GNN 피처, 1.5MB)
#   cell  100m 격자 셀 3,699 → 집계구 1,303곳 (Page 유동·밀도 레이어)
# 셋의 합집합이 living_population_jipgyegu 의 keep-list 다(1,501곳). 하나라도 빠지면
# 재수집 때 대상이 조용히 좁아지고, 그만큼의 셀·노드가 값 없이 폴백으로 내려간다.
!data/silver/unit_jipgyegu.json
!data/silver/node_jipgyegu.json
!data/silver/cell_jipgyegu.json
!data/gold/.gitkeep
*.parquet
*.glb
# 가로수길 gold 실데이터(~0.8MB) 전체 예외 — **지금은 실효가 없다(2026-08-15 확인).**
# 뒤따르는 43번 `data/gold/*/*` 가 마지막 매치 우선 규칙으로 이 두 줄을 덮는다.
#   git check-ignore -v --no-index data/gold/garosugil/building_vacancy.json
#   → .gitignore:43:data/gold/*/*
# 지금 추적 중인 8개 파일(building_vacancy.json·parquet 2개 포함)이 git 에 남아 있는 것은
# 이 예외가 살아서가 아니라 **이미 추적 중인 파일에는 gitignore 가 적용되지 않기 때문**이다.
# 그래서 이 디렉터리에 새로 생기는 산출물은 조용히 빠진다(calibration.json·vacant_units.json
# 이 그 상태). 넣으려면 `git add -f` 하거나, 예외를 되살리려면 이 두 줄을 43번 **뒤로**
# 옮긴다 — .vercelignore 39~40 줄이 정확히 그렇게 배치돼 있다(거기서는 유효하다).
!data/gold/garosugil/
!data/gold/garosugil/**
# 예외: Platform LSTM 분기 예측(수 KB) — 백엔드 predict-vacancy 가 정적 서빙.
!data/gold/platform_vacancy_forecast.json
# 예외: Platform GNN 업종 추천(~8.0MB, 40,388노드) — recommend-industry 가 정적 서빙.
!data/gold/platform_industry_recommend.json
# 예외: Posting 3-Tier 실데이터 입력(~7KB) — services/posting_inputs.py 가 정적 서빙.
!data/gold/platform_posting_inputs.json
# 예외: Posting 매출계수의 실측 근거(28KB) — 상권×업종 점포당 월매출.
# scripts/posting_cost_sensitivity.py 가 읽어 R1(실측수준정렬) 축을 만든다. 빠지면
# 그 축이 **조용히 통째로 빠진 채** 감도표가 찍혀 "통과 조합 없음"으로 뒤집힌다.
!data/gold/platform_posting_revenue.json
# 예외: Posting 비용 모델의 실측 근거(~4KB) — KOSIS 서비스업조사 서울 2024 tier별
# 영업비용률. districts.tier_scenarios 가 month_cost 를 여기서 읽는다. 빠지면
# 배포에서 비용률이 없어 조용히 **원가·인건비 없는 옛 모델**로 되돌아간다.
!data/gold/platform_posting_cost_rates.json
# 예외: 공정위 가맹사업 정보공개서 기반 평균 점포 면적 A(914B). **누락돼 있었다
# (2026-08-25 발견).** 형제 세 파일(revenue·cost_rates·inputs)은 예외가 걸려 있는데
# 이것만 빠져 있어, 새로 클론한 환경(CI·Vercel)에서는 파일이 없어 posting_revenue 가
# 임차료 **역산 폴백**으로 내려간다 — §0-I 가 "한식집 7.1평은 실물이 아니었다"고
# 기각한 바로 그 모델이다. area_basis() 가 "ftc" → "rent" 로 바뀌므로 조용하지는
# 않지만, 아무도 안 보면 조용한 것과 같다.
!data/gold/platform_posting_store_area.json
# 예외: Program 상권 행사(~480KB, 52거점 785건) — services/events.py 가 정적 서빙.
# 빠지면 배포 환경에서 events_source 가 "seed" 로 떨어져 지어낸 행사가 지도에 다시 찍힌다.
!data/gold/platform_events.json
# 예외: Page 유동·밀도 레이어(81KB, 54거점 190상권) — services/footfall_layer 가
# 정적 서빙한다. 원천은 features/trdar_demand.parquet 이지만 **파케이는 배포에
# 없다**(pandas·pyarrow 미탑재). 빠지면 유동 레이어가 조용히 비고, 예전처럼
# Math.random() 샘플로 되돌아간 것과 구분이 안 된다.
!data/gold/platform_page_footfall.json
# 예외: Page **24시간 시간축**(생활인구 행정동, 08-24) — footfall_layer.hourly_share 가
# 정적 서빙한다. 원천은 bronze 원본이라 배포에 없다. 빠지면 배포 환경에서 시간 축이
# **영영 6구간으로만** 뜨는데, 응답이 `time_source:"trdar_band"` 로 정상 폴백을
# 밝히기 때문에 고장으로 안 보인다 — 로컬에서만 24시간이 되는 상태가 된다.
!data/gold/page_footfall_hourly.json

# 유닛 단위 foot (집계구 생활인구 × SGIS 2016 4Q 경계 PIP) — **서빙이 읽는다**
# (posting_inputs._unit_jipgyegu_flpop). 빠지면 새 클론에서 조용히 상권 폴백으로
# 내려간다 — platform_posting_store_area.json 이 그렇게 빠져 있었다(08-25).
!data/gold/platform_unit_foot.json
# 예외: Page 유동·밀도 레이어의 **집계구** 판(604KB, 54거점 1,303집계구 × 24시간).
# services/footfall_layer 가 정적 서빙한다. 빠지면 `jipgyegu_of()` 가 None 을 돌려
# 레이어가 **조용히 상권 단위로 되돌아간다** — 화면은 멀쩡해 보이고 배지만 바뀌므로
# 아무도 안 본다. 그게 이 저장소가 반복해 온 실패 양식이다(형제 파일들의 주석 참조).
!data/gold/page_footfall_jipgyegu.json
# 예외: Page 다거점 red dot 실데이터 — 각 거점 page_building_master.geojson 만 추적(Vercel 서빙).
# building_vacancy.json·대장 원본·parquet 등 중간·원본 산출물은 계속 제외.
!data/gold/*/
data/gold/*/*
!data/gold/*/page_building_master.geojson
!data/gold/*/building_history.json
# 예외: 커버리지 리포트(거점당 ~600B) — 관리자 API 가 디스크에서 읽으므로 배포에 필요.
!data/gold/*/coverage.json
# 예외: R-ONE 앵커·α(거점당 ~3.5KB, 40거점 합계 143KB) — services/gold_vacancy.anchor_of 가
# 디스크에서 읽어 `anchor_pct`/`anchor_gap_pp` 로 내려보낸다. 2026-08-15 까지 빠져 있어
# **프로덕션에서는 garosugil(디렉터리 통째 추적)만 앵커가 붙고 나머지는 조용히 None** 이었다.
!data/gold/*/calibration.json
# 예외: 실제 공실 유닛 인벤토리(54거점 580유닛, 합계 388KB) — Posting 시뮬레이션과
# Program 자리층의 재료다. 08-22 에 54/54 를 채워 놓고도 추적 밖이라 배선이 막혀
# 있었다(calibration.json 이 40거점에서 조용히 None 이던 것과 똑같은 실패 양식).
# 빠지면 배포 환경에서 자리층이 통째로 비고, 화면은 "공실이 없다"처럼 보인다.
!data/gold/*/vacant_units.json
# 예외: TRDAR 상권 수요신호(190행 96KB) — ml/training/train_gnn.py 가 GNN 노드 피처로 읽는다.
# 빠지면 재학습이 조용히 수요 피처 없이(58열) 돌아 lift 가 +4.4% → +3.1% 로 되돌아간다.
# 서빙(recommend json)은 영향 없지만 **재현이 불가능해진다**.
!data/gold/features/
!data/gold/features/trdar_demand.parquet
# 예외: Page 건물 물리·대장 피처(40,388행 684KB) — 같은 이유다. train_gnn._building_block
# 이 읽고, 빠지면 재학습이 조용히 95열로 돌아 off-prior 개선분이 사라진다.
# 소스는 gold/*/page_building_master.geojson(추적 중)이므로 재생성은 가능하지만,
# 재생성 없이 학습을 돌리면 '조용히 이전 피처'가 되는 게 문제다.
!data/gold/features/page_building.parquet
# 예외: 행정동 24시간 생활인구 피처(136행 ~20KB) — train_gnn._adong_hour_block 이
# `--adong` 으로 읽는다. 08-24 실측에서 off-prior 를 못 올려 **기본 off** 이고 서빙에도
# 안 쓰이지만, 빠지면 음성결과를 재현할 수 없다. 안 올랐다는 사실 자체가 산출물이라
# (지우면 다음 사람이 같은 것을 다시 시도한다 — docs/feature-platform.md §0-J) 남긴다.
!data/gold/features/adong_hourly.parquet
# 예외: Program 상권 컨텍스트(거점당 ~3KB, 54거점 합계 174KB) — services/marketing.py 가
# LLM 프롬프트 입력으로 디스크에서 읽는다. 빠져 있으면 배포 환경에서 garosugil 만
# 컨텍스트를 갖고 나머지 53거점은 조용히 시드 카피로 폴백한다(2026-08-01 발견).
!data/gold/*/program_content_context.csv

# 수집 로그 — **반드시 제외**. 건축HUB 오류 메시지는 실패한 요청 URL 을 통째로 찍는데
# 거기에 serviceKey 가 평문으로 들어간다(2026-07-26 bldgvac-stdout.log 에서 103건 확인).
data/logs/
*.log

