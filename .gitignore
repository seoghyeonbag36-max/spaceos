# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.env
.mlruns/
mlruns/

# 로컬 `vercel build` 스캐폴드 — 커밋도 배포도 하지 않는다(.vercelignore 도 같이 막는다).
# requires-python 이 로컬 파이썬을 따라 적혀 원격 빌드(3.12+)를 깨뜨린다(2026-08-16).
/pyproject.toml
/uv.lock
.vercel/
# CLI 가 설치해 두는 패키지 사본(1,612파일 19MB) — sys.path 에 없어 런타임과 무관하다
.vercel_python_packages/

# Node
node_modules/
dist/
.vite/
*.local

# Data lake (로컬 레이어 — 원본/대용량 제외)
data/bronze/*
data/silver/*
data/gold/*
!data/bronze/.gitkeep
!data/silver/.gitkeep
!data/gold/.gitkeep
*.parquet
*.glb
# 가로수길 gold 실데이터(~0.8MB) 전체 예외 — **지금은 실효가 없다(2026-08-15 확인).**
# 뒤따르는 43번 `data/gold/*/*` 가 마지막 매치 우선 규칙으로 이 두 줄을 덮는다.
#   git check-ignore -v --no-index data/gold/garosugil/building_vacancy.json
#   → .gitignore:43:data/gold/*/*
# 지금 추적 중인 8개 파일(building_vacancy.json·parquet 2개 포함)이 git 에 남아 있는 것은
# 이 예외가 살아서가 아니라 **이미 추적 중인 파일에는 gitignore 가 적용되지 않기 때문**이다.
# 그래서 이 디렉터리에 새로 생기는 산출물은 조용히 빠진다(calibration.json·vacant_units.json
# 이 그 상태). 넣으려면 `git add -f` 하거나, 예외를 되살리려면 이 두 줄을 43번 **뒤로**
# 옮긴다 — .vercelignore 39~40 줄이 정확히 그렇게 배치돼 있다(거기서는 유효하다).
!data/gold/garosugil/
!data/gold/garosugil/**
# 예외: Platform LSTM 분기 예측(수 KB) — 백엔드 predict-vacancy 가 정적 서빙.
!data/gold/platform_vacancy_forecast.json
# 예외: Platform GNN 업종 추천(~8.0MB, 40,388노드) — recommend-industry 가 정적 서빙.
!data/gold/platform_industry_recommend.json
# 예외: Posting 3-Tier 실데이터 입력(~7KB) — services/posting_inputs.py 가 정적 서빙.
!data/gold/platform_posting_inputs.json
# 예외: Program 상권 행사(~480KB, 52거점 785건) — services/events.py 가 정적 서빙.
# 빠지면 배포 환경에서 events_source 가 "seed" 로 떨어져 지어낸 행사가 지도에 다시 찍힌다.
!data/gold/platform_events.json
# 예외: Page 다거점 red dot 실데이터 — 각 거점 page_building_master.geojson 만 추적(Vercel 서빙).
# building_vacancy.json·대장 원본·parquet 등 중간·원본 산출물은 계속 제외.
!data/gold/*/
data/gold/*/*
!data/gold/*/page_building_master.geojson
!data/gold/*/building_history.json
# 예외: 커버리지 리포트(거점당 ~600B) — 관리자 API 가 디스크에서 읽으므로 배포에 필요.
!data/gold/*/coverage.json
# 예외: R-ONE 앵커·α(거점당 ~3.5KB, 40거점 합계 143KB) — services/gold_vacancy.anchor_of 가
# 디스크에서 읽어 `anchor_pct`/`anchor_gap_pp` 로 내려보낸다. 2026-08-15 까지 빠져 있어
# **프로덕션에서는 garosugil(디렉터리 통째 추적)만 앵커가 붙고 나머지는 조용히 None** 이었다.
!data/gold/*/calibration.json
# 예외: TRDAR 상권 수요신호(190행 96KB) — ml/training/train_gnn.py 가 GNN 노드 피처로 읽는다.
# 빠지면 재학습이 조용히 수요 피처 없이(58열) 돌아 lift 가 +4.4% → +3.1% 로 되돌아간다.
# 서빙(recommend json)은 영향 없지만 **재현이 불가능해진다**.
!data/gold/features/
!data/gold/features/trdar_demand.parquet
# 예외: Page 건물 물리·대장 피처(40,388행 684KB) — 같은 이유다. train_gnn._building_block
# 이 읽고, 빠지면 재학습이 조용히 95열로 돌아 off-prior 개선분이 사라진다.
# 소스는 gold/*/page_building_master.geojson(추적 중)이므로 재생성은 가능하지만,
# 재생성 없이 학습을 돌리면 '조용히 이전 피처'가 되는 게 문제다.
!data/gold/features/page_building.parquet
# 예외: Program 상권 컨텍스트(거점당 ~3KB, 54거점 합계 174KB) — services/marketing.py 가
# LLM 프롬프트 입력으로 디스크에서 읽는다. 빠져 있으면 배포 환경에서 garosugil 만
# 컨텍스트를 갖고 나머지 53거점은 조용히 시드 카피로 폴백한다(2026-08-01 발견).
!data/gold/*/program_content_context.csv

# 수집 로그 — **반드시 제외**. 건축HUB 오류 메시지는 실패한 요청 URL 을 통째로 찍는데
# 거기에 serviceKey 가 평문으로 들어간다(2026-07-26 bldgvac-stdout.log 에서 103건 확인).
data/logs/
*.log

